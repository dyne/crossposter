{
  "name": "@apoorvdarshan/crossposter",
  "version": "1.1.16",
  "description": "Local-first social publishing dashboard for accounts you control.",
  "license": "MIT",
  "homepage": "https://crossposter.apoorvdarshan.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apoorvdarshan/crossposter.git"
  },
  "bugs": {
    "url": "https://github.com/apoorvdarshan/crossposter/issues"
  },
  "bin": {
    "crossposter": "bin/crossposter.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.mjs",
    "next-env.d.ts",
    "requirements.txt",
    "tsconfig.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENT_POSTING.md"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/run-local.mjs",
    "crossposter": "node bin/crossposter.mjs",
    "local:install": "./scripts/install-local-service.sh",
    "local:uninstall": "./scripts/uninstall-local-service.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:browser-verification": "python3 -B -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "typescript": "^5.9.3",
    "youtubei.js": "^17.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}

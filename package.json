{
  "name": "@apoorvdarshan/crossposter",
  "version": "1.1.16",
  "description": "Local-first social publishing dashboard for accounts you control.",
  "license": "MIT",
  "homepage": "https://dyne.org/crossposter/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dyne/crossposter.git"
  },
  "bugs": {
    "url": "https://github.com/dyne/crossposter/issues"
  },
  "bin": {
    "crossposter": "bin/crossposter.mjs"
  },
  "files": [
    "app",
    "bin",
    "components",
    "lib",
    "public",
    "scripts",
    "next.config.mjs",
    "next-env.d.ts",
    "requirements.txt",
    "tsconfig.json",
    "README.md",
    "CONTRIBUTING.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "LICENSE",
    "AGENT_POSTING.md"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/run-local.mjs",
    "crossposter": "node bin/crossposter.mjs",
    "local:install": "./scripts/install-local-service.sh",
    "local:uninstall": "./scripts/uninstall-local-service.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:boundaries": "node --test tests/architecture/import-boundaries.test.mjs",
    "test:e2e": "playwright test",
    "test:browser-verification": "python3 -B -m unittest discover -s tests -p 'test_*.py'"
  },
  "dependencies": {
    "image-size": "^2.0.4",
    "lucide-react": "^0.577.0",
    "next": "^15.5.28",
    "nostr-tools": "^2.25.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.35.0",
    "typescript": "^5.9.3",
    "youtubei.js": "^17.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "jsdom": "30.1.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
